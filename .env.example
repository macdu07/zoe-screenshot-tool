# Public URL allowed to call the API from browser JavaScript. Leave empty for same-origin only.
CORS_ORIGIN=https://screenshots.example.com

# Recommended before exposing the application publicly.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password

# Puppeteer workload limits. Start conservatively and tune after monitoring RAM.
CAPTURE_CONCURRENCY=2
CAPTURE_QUEUE_LIMIT=20
CAPTURE_RATE_LIMIT=30
CAPTURE_RATE_WINDOW_MS=60000
MAX_OUTPUT_PIXELS=100000000
MAX_PAGE_HEIGHT=30000
MAX_SCREENSHOT_BYTES=52428800
NAVIGATION_TIMEOUT_MS=30000
HISTORY_LIMIT=30

# Dokploy/Traefik normally adds one trusted proxy hop.
TRUST_PROXY_HOPS=1

# Keep both disabled in production.
ALLOW_PRIVATE_NETWORK=false
EXPOSE_TEST_STATIC=false
